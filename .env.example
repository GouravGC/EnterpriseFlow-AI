
# EnterpriseFlow AI — Environment Configuration
# Copy this file to .env and add your own credentials.

# Application
ENVIRONMENT=development

# OpenRouter — chat answer generation
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# OpenRouter — document and query embeddings
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b:free

# ChromaDB — persistent vector storage
CHROMA_PATH=./data/chroma

# Optional LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enterpriseflow-ai
